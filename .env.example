# ==========================================
# Vibe Coder - Variables de Entorno (API Keys)
# ==========================================
# Copia este archivo a .env:
#   cp .env.example .env
# Y completa las claves que vayas a utilizar.

# Anthropic Claude Code CLI
ANTHROPIC_API_KEY=

# OpenAI Codex CLI
OPENAI_API_KEY=

# Railway CLI (Opcional si haces login interactivo con `railway login`)
RAILWAY_TOKEN=

# GitHub CLI (Opcional si haces login interactivo con `gh auth login`)
GH_TOKEN=
